package main

import (
	"encoding/json"
	"fmt"
	"os"
	"sort"
)

type QueryResult struct {
	Columns []string `json:"columns"`
	Rows    [][]string `json:"rows"`
}

func main() {
	nodesData, err := os.ReadFile("nodes.json")
	if err != nil {
		panic(err)
	}
	var nodesResult QueryResult
	if err := json.Unmarshal(nodesData, &nodesResult); err != nil {
		panic(err)
	}

	edgesData, err := os.ReadFile("edges.json")
	if err != nil {
		panic(err)
	}
	var edgesResult QueryResult
	if err := json.Unmarshal(edgesData, &edgesResult); err != nil {
		panic(err)
	}

	nodes := make(map[string]bool)
	for _, row := range nodesResult.Rows {
		nodes[row[0]] = true
	}

	adj := make(map[string][]string)
	for _, row := range edgesResult.Rows {
		u, v := row[0], row[1]
		// Only consider edges between LuceneClass nodes
		if nodes[u] && nodes[v] {
			adj[u] = append(adj[u], v)
		}
	}

	layers := make(map[string]int)
	visited := make(map[string]bool)

	var computeLayer func(string) int
	computeLayer = func(u string) int {
		if l, ok := layers[u]; ok {
			return l
		}
		if visited[u] {
			// Cycle detected, treat as layer 0 to avoid infinite recursion
			return 0
		}
		visited[u] = true
		maxL := -1
		for _, v := range adj[u] {
			l := computeLayer(v)
			if l > maxL {
				maxL = l
			}
		}
		visited[u] = false
		layers[u] = maxL + 1
		return layers[u]
	}

	for n := range nodes {
		computeLayer(n)
	}

	// Sort nodes by layer for cleaner output
	type nodeLayer struct {
		name  string
		layer int
	}
	var sortedNodes []nodeLayer
	for n, l := range layers {
		sortedNodes = append(sortedNodes, nodeLayer{n, l})
	}
	sort.Slice(sortedNodes, func(i, j int) bool {
		if sortedNodes[i].layer != sortedNodes[j].layer {
			return sortedNodes[i].layer < sortedNodes[j].layer
		}
		return sortedNodes[i].name < sortedNodes[j].name
	})

	// Group by layer to minimize rmp calls
	currentLayer := -1
	var currentBatch []string
	for _, nl := range sortedNodes {
		if nl.layer != currentLayer {
			if len(currentBatch) > 0 {
				printUpdate(currentLayer, currentBatch)
			}
			currentLayer = nl.layer
			currentBatch = []string{}
		}
		currentBatch = append(currentBatch, nl.name)
	}
	if len(currentBatch) > 0 {
		printUpdate(currentLayer, currentBatch)
	}
}

func printUpdate(layer int, names []string) {
	// Use a simplified format for the batch update
	// rmp graph update "MATCH (n:LuceneClass) WHERE n.name IN ['A', 'B'] SET n.layer = layer"

	var nameList string
	for i, name := range names {
		if i > 0 {
			nameList += ", "
		}
		nameList += fmt.Sprintf("'%s'", name)
	}

	fmt.Printf("rmp graph update \"MATCH (n:LuceneClass) WHERE n.name IN [%s] SET n.layer = %d\"\n", nameList, layer)
}
