package search

import (
	"fmt"
	"math"
	"sort"

	"github.com/FlavioCFOliveira/Gocene/util"
)

// disjunctionScoreBlockBoundaryPropagator is a helper to propagate block boundaries for disjunctions.
// It computes block boundaries only across clauses whose maximum score is greater than or equal to
// the minimum competitive score, or the maximum scoring clause if there is no such clause.
//
// Ported from org.apache.lucene.search.DisjunctionScoreBlockBoundaryPropagator (Lucene 10.5.0).
type disjunctionScoreBlockBoundaryPropagator struct {
	scorers   []Scorer
	maxScores []float32
	leadIndex int
}

func newDisjunctionScoreBlockBoundaryPropagator(subScorers []Scorer) (*disjunctionScoreBlockBoundaryPropagator, error) {
	scorers := make([]Scorer, len(subScorers))
	copy(scorers, subScorers)

	for _, s := range scorers {
		_, err := s.AdvanceShallow(0)
		if err != nil {
			return nil, fmt.Errorf("failed to advance shallow: %w", err)
		}
	}

	sort.Slice(scorers, func(i, j int) bool {
		maxI, errI := scorers[i].GetMaxScore(util.NO_MORE_DOCS)
		maxJ, errJ := scorers[j].GetMaxScore(util.NO_MORE_DOCS)
		if errI != nil || errJ != nil {
			// In Java this is wrapped in RuntimeException.
			return false
		}
		if maxI != maxJ {
			return maxI > maxJ
		}
		return scorers[i].Iterator().Cost() < scorers[j].Iterator().Cost()
	})

	maxScores := make([]float32, len(scorers))
	for i := 0; i < len(scorers); i++ {
		max, err := scorers[i].GetMaxScore(util.NO_MORE_DOCS)
		if err != nil {
			return nil, fmt.Errorf("failed to get max score: %w", err)
		}
		maxScores[i] = max
	}

	return &disjunctionScoreBlockBoundaryPropagator{
		scorers:   scorers,
		maxScores: maxScores,
		leadIndex: 0,
	}, nil
}

func (p *disjunctionScoreBlockBoundaryPropagator) advanceShallow(target int) (int, error) {
	for i := 0; i < p.leadIndex; i++ {
		s := p.scorers[i]
		if s.DocID() < target {
			if _, err := s.AdvanceShallow(target); err != nil {
				return util.NO_MORE_DOCS, err
			}
		}
	}

	leadScorer := p.scorers[p.leadIndex]
	targetVal := leadScorer.DocID()
	if target > targetVal {
		targetVal = target
	}
	upTo, err := leadScorer.AdvanceShallow(targetVal)
	if err != nil {
		return util.NO_MORE_DOCS, err
	}

	for i := p.leadIndex + 1; i < len(p.scorers); i++ {
		scorer := p.scorers[i]
		if scorer.DocID() <= target {
			adv, err := scorer.AdvanceShallow(target)
			if err != nil {
				return util.NO_MORE_DOCS, err
			}
			if adv < upTo {
				upTo = adv
			}
		}
	}

	for i := len(p.scorers) - 1; i > p.leadIndex; i-- {
		scorer := p.scorers[i]
		if scorer.DocID() > target {
			if scorer.DocID()-1 < upTo {
				upTo = scorer.DocID() - 1
			}
		} else {
			break
		}
	}

	return upTo, nil
}

func (p *disjunctionScoreBlockBoundaryPropagator) setMinCompetitiveScore(minScore float32) {
	for p.leadIndex < len(p.maxScores)-1 && minScore > p.maxScores[p.leadIndex] {
		p.leadIndex++
	}
}
