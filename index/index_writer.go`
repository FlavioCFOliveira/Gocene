type eventQueue struct {
	closed bool
	permits chan struct{}
	queue   []Event
	writer  *IndexWriter
	mu      sync.Mutex
}

func newEventQueue(writer *IndexWriter) *eventQueue {
	return &eventQueue{
		permits: make(chan struct{}, 1<<30),
		writer:  writer,
	}
}

func (eq *eventQueue) add(event Event) bool {
	eq.mu.Lock()
	defer eq.mu.Unlock()
	if eq.closed {
		return false
	}
	eq.queue = append(eq.queue, event)
	return true
}

func (eq *eventQueue) processEvents() error {
	eq.mu.Lock()
	defer eq.mu.Unlock()
	for len(eq.queue) > 0 {
		event := eq.queue[0]
		eq.queue = eq.queue[1:]
		if err := event.process(eq.writer); err != nil {
			return err
		}
	}
	return nil
}

func (eq *eventQueue) close() error {
	eq.mu.Lock()
	defer eq.mu.Unlock()
	if eq.closed {
		return nil
	}
	eq.closed = true
	if eq.writer.getTragicException() != nil {
		eq.queue = nil
	} else {
		_ = eq.processEvents()
	}
	return nil
}

type Event interface {
	process(writer *IndexWriter) error
}

type indexWriterMergeSource struct {
	writer *IndexWriter
}

func (s *indexWriterMergeSource) getNextMerge() MergePolicyOneMerge {
	s.writer.mu.Lock()
	defer s.writer.mu.Unlock()
	if s.writer.tragedy.Load() != nil {
		panic(fmt.Sprintf("this writer hit an unrecoverable error; cannot merge: %v", s.writer.tragedy.Load()))
	}
	if len(s.writer.pendingMerges) == 0 {
		return nil
	}
	merge := s.writer.pendingMerges[0]
	s.writer.pendingMerges = s.writer.pendingMerges[1:]
	s.writer.runningMerges[merge] = true
	return merge
}

func (s *indexWriterMergeSource) onMergeFinished(merge MergePolicyOneMerge) {
	s.writer.mu.Lock()
	defer s.writer.mu.Unlock()
	delete(s.writer.runningMerges, merge)
}

type addIndexesMergeSource struct {
	writer *IndexWriter
	pendingAddIndexesMerges []MergePolicyOneMerge
	mu sync.Mutex
}

func newAddIndexesMergeSource(writer *IndexWriter) *addIndexesMergeSource {
	return &addIndexesMergeSource{writer: writer}
}

func (s *addIndexesMergeSource) registerMerge(merge MergePolicyOneMerge) {
	s.writer.addEstimatedBytesToMerge(merge)
	s.writer.mu.Lock()
	defer s.writer.mu.Unlock()
	s.pendingAddIndexesMerges = append(s.pendingAddIndexesMerges, merge)
}

func (s *addIndexesMergeSource) getNextMerge() MergePolicyOneMerge {
	s.writer.mu.Lock()
	defer s.writer.mu.Unlock()
	if len(s.pendingAddIndexesMerges) == 0 {
		return nil
	}
	merge := s.pendingAddIndexesMerges[0]
	s.pendingAddIndexesMerges = s.pendingAddIndexesMerges[1:]
	s.writer.runningMerges[merge] = true
	return merge
}

func (s *addIndexesMergeSource) onMergeFinished(merge MergePolicyOneMerge) {
	s.writer.mu.Lock()
	defer s.writer.mu.Unlock()
	delete(s.writer.runningMerges, merge)
}

func (s *addIndexesMergeSource) hasPendingMerges() bool {
	s.mu.Lock()
	defer s.mu.Unlock()
	return len(s.pendingAddIndexesMerges) > 0
}

func (s *addIndexesMergeSource) abortPendingMerges() error {
	s.writer.mu.Lock()
	defer s.writer.mu.Unlock()
	for _, merge := range s.pendingAddIndexesMerges {
		merge.setAborted()
		merge.close(false, false, func(mr MergeReader) {})
		s.writer.onMergeFinished(merge)
	}
	s.pendingAddIndexesMerges = nil
	return nil
}

func (s *addIndexesMergeSource) merge(merge MergePolicyOneMerge) error {
	success := false
	defer func() {
		s.writer.mu.Lock()
		merge.close(success, false, func(mr MergeReader) {})
		s.writer.onMergeFinished(merge)
		s.writer.mu.Unlock()
	}()

	err := s.writer.addIndexesReaderMerge(merge)
	if err != nil {
		s.writer.handleMergeException(err, merge)
		return err
	}
	success = true
	return nil
}

