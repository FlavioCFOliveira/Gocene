var actualMaxDocs = MaxDocs

func SetMaxDocs(maxDocs int) {
	if maxDocs > MaxDocs {
		panic(fmt.Sprintf("maxDocs must be <= IndexWriter.MAX_DOCS=%d; got: %d", MaxDocs, maxDocs))
	}
	actualMaxDocs = maxDocs
}

func GetActualMaxDocs() int {
	return actualMaxDocs
}

