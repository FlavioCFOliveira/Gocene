func readFieldInfos(si SegmentCommitInfo) (*FieldInfos, error) {
	codec := si.SegmentInfo().GetCodec()
	format := codec.FieldInfosFormat()
	if si.HasFieldUpdates() {
		suffix := fmt.Sprintf("%x", si.FieldInfosGen()) // Simplified base36
		return format.Read(si.SegmentInfo().Dir(), si.SegmentInfo(), suffix, store.IOContextReadOnce)
	} else if si.SegmentInfo().GetUseCompoundFile() {
		cfs, err := codec.CompoundFormat().GetCompoundReader(si.SegmentInfo().Dir(), si.SegmentInfo())
		if err != nil {
			return nil, err
		}
		defer cfs.Close()
		return format.Read(cfs, si.SegmentInfo(), "", store.IOContextReadOnce)
	} else {
		return format.Read(si.SegmentInfo().Dir(), si.SegmentInfo(), "", store.IOContextReadOnce)
	}
}

func getLastCommitSegmentsFileName(files []string) *string {
	// Simplified; should find latest segments_N
	for _, f := range files {
		if strings.HasPrefix(f, "segments_") {
			return &f
		}
	}
	return nil
}

func (iw *IndexWriter) changed() {
	iw.changeCount.Add(1)
	iw.segmentInfos.Changed()
}

func (iw *IndexWriter) newSegmentName() string {
	iw.mu.Lock()
	defer iw.mu.Unlock()
	iw.changeCount.Add(1)
	iw.segmentInfos.Changed()
	return "_" + fmt.Sprintf("%x", iw.segmentInfos.Counter())
}
