func NewIndexWriter(d util.Directory, conf *IndexWriterConfig) (*IndexWriter, error) {
	conf.setIndexWriter(nil) // Simplified; Java setIndexWriter(this)

	writeLock, err := d.ObtainLock(WriteLockName)
	if err != nil {
		return nil, err
	}

	iw := &IndexWriter{
		directoryOrig:  d,
		config:         conf.LiveIndexWriterConfig,
		mergeScheduler: conf.GetMergeScheduler(),
	}

	infoStream := iw.config.GetInfoStream()
	iw.softDeletesEnabled = iw.config.GetSoftDeletesField() != ""
	iw.eventListener = iw.config.GetIndexWriterEventListener()
	iw.writeLock = writeLock

	success := false
	defer func() {
		if !success {
			if infoStream.IsEnabled("IW") {
				infoStream.Message("IW", "init: hit exception on init; releasing write lock")
			}
			_ = writeLock.Close()
		}
	}()

	iw.directory = &lockValidatingDirectoryWrapper{dir: d, lock: writeLock}
	iw.mergeScheduler.Initialize(infoStream, d)

	mode := conf.GetOpenMode()
	indexExists := false
	if sis, err := ReadSegmentInfos(iw.directory); err == nil {
		indexExists = true
		_ = sis
	}

	var create bool
	switch mode {
	case Create:
		create = true
	case Append:
		indexExists = true
		create = false
	case CreateOrAppend:
		create = !indexExists
	}

	var reader *DirectoryReader
	commit := conf.GetIndexCommit()

	if create {
		if commit != nil {
			if mode == Create {
				return nil, fmt.Errorf("cannot use IndexWriterConfig.setIndexCommit() with OpenMode.CREATE")
			}
			return nil, fmt.Errorf("cannot use IndexWriterConfig.setIndexCommit() when index has no commit")
		}

		sis := NewSegmentInfos(iw.config.GetIndexCreatedVersionMajor())
		if indexExists {
			previous, err := ReadSegmentInfos(iw.directory)
			if err == nil {
				sis.UpdateGenerationVersionAndCounter(previous)
			}
		}
		iw.segmentInfos = sis
		iw.rollbackSegments = iw.segmentInfos.CreateBackupSegmentInfos()
		iw.changed()
	} else if reader != nil {
		// Init from existing reader...
		// (Not implemented yet, but planned)
	} else {
		// Init from latest commit or explicit commit
		files, err := iw.directory.ListAll()
		if err != nil {
			return nil, err
		}
		lastSegmentsFile := getLastCommitSegmentsFileName(files)
		if lastSegmentsFile == nil {
			return nil, fmt.Errorf("no segments* file found in %v", iw.directory)
		}

		iw.segmentInfos, err = ReadCommit(iw.directoryOrig, lastSegmentsFile)
		if err != nil {
			return nil, err
		}

		if commit != nil {
			if commit.GetDirectory() != iw.directoryOrig {
				return nil, fmt.Errorf("IndexCommit's directory doesn't match my directory")
			}
			oldInfos, err := ReadCommit(iw.directoryOrig, commit.GetSegmentsFileName())
			if err != nil {
				return nil, err
			}
			iw.segmentInfos.Replace(oldInfos)
			iw.changed()
		}
		iw.rollbackSegments = iw.segmentInfos.CreateBackupSegmentInfos()
	}

	if infoStream.IsEnabled("IW") {
		infoStream.Message("IW", fmt.Sprintf("init %s", iw.segmentInfos.StringVerbose()))
	}

	iw.commitUserData = make([]MapEntry, 0)
	for k, v := range iw.segmentInfos.GetUserData() {
		iw.commitUserData = append(iw.commitUserData, MapEntry{Key: k, Value: v})
	}

	iw.pendingNumDocs.Store(int64(iw.segmentInfos.TotalMaxDoc()))

	var errMap error
	iw.globalFieldNumberMap, errMap = iw.getFieldNumberMap()
	if errMap != nil {
		return nil, errMap
	}

	if err := iw.validateIndexSort(); err != nil {
		return nil, err
	}

	iw.config.GetFlushPolicy().Init(iw.config)
	iw.bufferedUpdatesStream = NewBufferedUpdatesStream(infoStream)
	iw.docWriter = NewDocumentsWriter(
		iw.flushNotifications,
		iw.segmentInfos.GetIndexCreatedVersionMajor(),
		&iw.pendingNumDocs,
		false, // enableTestPoints
		iw.newSegmentName,
		iw.config,
		iw.directoryOrig,
		iw.directory,
		iw.globalFieldNumberMap,
	)

	iw.readerPool = NewReaderPool(
		iw.directory,
		iw.directoryOrig,
		iw.segmentInfos,
		iw.globalFieldNumberMap,
		iw.bufferedUpdatesStream.GetCompletedDelGen,
		infoStream,
		iw.config.GetSoftDeletesField(),
		reader,
	)
	if conf.GetReaderPooling() {
		iw.readerPool.EnableReaderPooling()
	}

	iw.mu.Lock()
	iw.deleter = NewIndexFileDeleter(
		files,
		iw.directoryOrig,
		iw.directory,
		conf.GetIndexDeletionPolicy(),
		iw.segmentInfos,
		infoStream,
		iw,
		indexExists,
		reader != nil,
	)
	iw.mu.Unlock()

	if iw.deleter.StartingCommitDeleted {
		iw.changed()
	}

	if reader != nil {
		iw.segmentInfos.Changed()
		iw.changed()
	}

	success = true
	return iw, nil
}

func (iw *IndexWriter) getFieldNumberMap() (*FieldNumbers, error) {
	fmap := NewFieldNumbers(iw.config.GetSoftDeletesField(), iw.config.GetParentField())
	for i := 0; i < iw.segmentInfos.Size(); i++ {
		info := iw.segmentInfos.Get(i)
		fis, err := readFieldInfos(info)
		if err != nil {
			return nil, err
		}
		for _, fi := range fis {
			fmap.AddOrGet(fi)
		}
	}
	return fmap, nil
}

func (iw *IndexWriter) validateIndexSort() error {
	indexSort := iw.config.GetIndexSort()
	if indexSort == nil {
		return nil
	}
	for i := 0; i < iw.segmentInfos.Size(); i++ {
		info := iw.segmentInfos.Get(i)
		segmentIndexSort := info.SegmentInfo().GetIndexSort()
		if segmentIndexSort == nil || !isCongruentSort(indexSort, segmentIndexSort) {
			return fmt.Errorf("cannot change previous indexSort=%v to new indexSort=%v", segmentIndexSort, indexSort)
		}
	}
	return nil
}

