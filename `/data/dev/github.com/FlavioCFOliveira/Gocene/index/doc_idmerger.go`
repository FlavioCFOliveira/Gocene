package index

import (
	"fmt"
	"math"
)

const NO_MORE_DOCS = math.MaxInt32

// Sub represents one sub-reader being merged.
type Sub interface {
	// NextDoc returns the next document ID from this sub reader,
	// and NO_MORE_DOCS when done.
	NextDoc() (int, error)
	// DocMap returns the map from old to new doc IDs.
	DocMap() DocMap
	// GetMappedDocID returns the currently mapped doc ID.
	GetMappedDocID() int
	// SetMappedDocID sets the currently mapped doc ID.
	SetMappedDocID(id int)
}

// nextMappedDoc returns the next mapped document ID from this sub reader,
// and NO_MORE_DOCS when exhausted. This function sets the mapped doc ID
// as a side effect.
func nextMappedDoc(s Sub) (int, error) {
	for {
		doc, err := s.NextDoc()
		if err != nil {
			return NO_MORE_DOCS, err
		}
		if doc == NO_MORE_DOCS {
			s.SetMappedDocID(NO_MORE_DOCS)
			return NO_MORE_DOCS, nil
		}
		mappedDoc := s.DocMap().Get(doc)
		if mappedDoc != -1 {
			s.SetMappedDocID(mappedDoc)
			return mappedDoc, nil
		}
	}
}

// DocIDMerger is a utility to help merging documents from sub-readers according to either
// simple concatenated (unsorted) order, or by a specified index-time sort, skipping
// deleted documents and remapping non-deleted documents.
type DocIDMerger[T Sub] interface {
	// Reset re-initializes the merger.
	Reset() error
	// Next returns the next sub-reader containing the next document, or nil when done.
	Next() (T, error)
}

// Of constructs a DocIDMerger from the provided subs, specifying the maximum sub count.
func Of[T Sub](subs []T, maxCount int, indexIsSorted bool) (DocIDMerger[T], error) {
	if indexIsSorted && maxCount > 1 {
		return newSortedDocIDMerger[T](subs, maxCount)
	}
	return newSequentialDocIDMerger[T](subs), nil
}

// OfSimple constructs a DocIDMerger from the provided subs.
func OfSimple[T Sub](subs []T, indexIsSorted bool) (DocIDMerger[T], error) {
	return Of(subs, len(subs), indexIsSorted)
}

type sequentialDocIDMerger[T Sub] struct {
	subs      []T
	current   T
	nextIndex int
}

func newSequentialDocIDMerger[T Sub](subs []T) *sequentialDocIDMerger[T] {
	m := &sequentialDocIDMerger[T]{
		subs: subs,
	}
	_ = m.Reset()
	return m
}

func (m *sequentialDocIDMerger[T]) Reset() error {
	if len(m.subs) > 0 {
		m.current = m.subs[0]
		m.nextIndex = 1
	} else {
		var zero T
		m.current = zero
		m.nextIndex = 0
	}
	return nil
}

func (m *sequentialDocIDMerger[T]) Next() (T, error) {
	for {
		if m.current == nil {
			var zero T
			return zero, nil
		}
		nextDoc, err := nextMappedDoc(m.current)
		if err != nil {
			return m.current, err
		}
		if nextDoc == NO_MORE_DOCS {
			if m.nextIndex == len(m.subs) {
				var zero T
				m.current = zero
				return zero, nil
			}
			m.current = m.subs[m.nextIndex]
			m.nextIndex++
		} else {
			return m.current, nil
		}
	}
}

type sortedDocIDMerger[T Sub] struct {
	subs          []T
	current       T
	queue         *priorityQueue[T]
	queueMinDocID int
}

func newSortedDocIDMerger[T Sub](subs []T, maxCount int) (*sortedDocIDMerger[T], error) {
	if maxCount <= 1 {
		return nil, fmt.Errorf("maxCount must be > 1 for sorted merger")
	}
	m := &sortedDocIDMerger[T]{
		subs:  subs,
		queue: newPriorityQueue[T](maxCount - 1),
	}
	err := m.Reset()
	if err != nil {
		return nil, err
	}
	return m, nil
}

func (m *sortedDocIDMerger[T]) setQueueMinDocID() {
	if m.queue.len() > 0 {
		m.queueMinDocID = m.queue.top().GetMappedDocID()
	} else {
		m.queueMinDocID = NO_MORE_DOCS
	}
}

func (m *sortedDocIDMerger[T]) Reset() error {
	m.queue.clear()
	var zero T
	m.current = zero
	first := true
	for _, sub := range m.subs {
		if first {
			sub.SetMappedDocID(-1)
			m.current = sub
			first = false
		} else {
			nextDoc, err := nextMappedDoc(sub)
			if err != nil {
				return err
			}
			if nextDoc != NO_MORE_DOCS {
				m.queue.add(sub)
			}
		}
	}
	m.setQueueMinDocID()
	return nil
}

func (m *sortedDocIDMerger[T]) Next() (T, error) {
	if m.current == nil {
		var zero T
		return zero, nil
	}

	nextDoc, err := nextMappedDoc(m.current)
	if err != nil {
		return m.current, err
	}

	if nextDoc < m.queueMinDocID {
		return m.current, nil
	}

	if nextDoc == NO_MORE_DOCS {
		if m.queue.len() == 0 {
			var zero T
			m.current = zero
		} else {
			m.current = m.queue.pop()
		}
	} else {
		newCurrent := m.queue.top()
		m.queue.updateTop(m.current)
		m.current = newCurrent
	}

	m.setQueueMinDocID()
	return m.current, nil
}

type priorityQueue[T Sub] struct {
	data []T
}

func newPriorityQueue[T Sub](capacity int) *priorityQueue[T] {
	return &priorityQueue[T]{
		data: make([]T, 0, capacity),
	}
}

func (pq *priorityQueue[T]) len() int {
	return len(pq.data)
}

func (pq *priorityQueue[T]) top() T {
	return pq.data[0]
}

func (pq *priorityQueue[T]) clear() {
	pq.data = pq.data[:0]
}

func (pq *priorityQueue[T]) add(val T) {
	pq.data = append(pq.data, val)
	pq.up(len(pq.data) - 1)
}

func (pq *priorityQueue[T]) pop() T {
	top := pq.data[0]
	last := len(pq.data) - 1
	pq.data[0] = pq.data[last]
	pq.data = pq.data[:last]
	if len(pq.data) > 0 {
		pq.down(0)
	}
	return top
}

func (pq *priorityQueue[T]) updateTop(val T) {
	pq.data[0] = val
	pq.down(0)
}

func (pq *priorityQueue[T]) up(j int) {
	for {
		i := (j - 1) / 2
		if i == j || pq.data[j].GetMappedDocID() >= pq.data[i].GetMappedDocID() {
			break
		}
		pq.data[i], pq.data[j] = pq.data[j], pq.data[i]
		j = i
	}
}

func (pq *priorityQueue[T]) down(i int) {
	for {
		left := 2*i + 1
		if left >= len(pq.data) || left < 0 {
			break
		}
		smallest := left
		if right := left + 1; right < len(pq.data) && pq.data[right].GetMappedDocID() < pq.data[left].GetMappedDocID() {
			smallest = right
		}
		if pq.data[smallest].GetMappedDocID() >= pq.data[i].GetMappedDocID() {
			break
		}
		pq.data[i], pq.data[smallest] = pq.data[smallest], pq.data[i]
		i = smallest
	}
}
